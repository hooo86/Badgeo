DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
POSTGRES_HOST=db
POSTGRES_DB=badgeo
POSTGRES_USER=badgeo
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
TZ=Africa/Algiers
# Fernet key protecting device secrets: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DEVICE_SECRET_KEY=
# Behaviour switches
PUNCH_DEDUP_MINUTES=2          # punches closer than this are treated as duplicates in calculations
NO_PUNCH_BECOMES_ABSENCE=0     # 1: a closed workday without any punch becomes "absent" (default: "sans pointage", to review)
MOBILE_PUNCH_ENABLED=0         # 1: employees may punch from the mobile app (server time only)
MOBILE_PUNCH_ALLOWED_CIDRS=    # e.g. 10.0.0.0/8,192.168.0.0/16 : restrict mobile punching to the company network
TRUST_X_FORWARDED_FOR=0        # 1 only behind your own reverse proxy (needed for the CIDR check behind a proxy)
BACKUP_PASSPHRASE=             # used by deploy/backup.sh (keep it outside the server)
